import java.util.*;
import java.util.stream.*;
class Main {
    public static void main(String[] args) {
         List<Integer> all = Arrays.asList(2,31,26,73,98,80,3,4,5,6,7,8,9,10);

        List<Integer> primeNum = all.stream()
                .filter(i -> i > 1).filter(i->{
                    for(int m=2;m<=i/2;m++){
                        if(i%m==0){
                        return false;
                        }
                    }
                    return true;
                }).toList();
        System.out.println(primeNum);
    }
}
